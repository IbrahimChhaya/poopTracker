  "fixed_sql": [
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"occurred_at_utc_ms\" INTEGER NOT NULL, \"original_utc_offset_minutes\" INTEGER NOT NULL, \"has_time\" INTEGER NOT NULL DEFAULT 1 CHECK (\"has_time\" IN (0, 1)), \"comment\" TEXT NULL, \"stool_type\" INTEGER NULL, \"ease\" TEXT NULL, \"created_at_utc_ms\" INTEGER NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, CHECK (original_utc_offset_minutes BETWEEN -720 AND 840), CHECK (stool_type IS NULL OR stool_type BETWEEN 1 AND 7), CHECK (ease IS NULL OR ease IN ('easy', 'some_straining', 'difficult')));"
        }
      ]
    },
    {
      "name": "entry_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entry_tags\" (\"entry_id\" INTEGER NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"code\" TEXT NOT NULL, PRIMARY KEY (\"entry_id\", \"code\"), CHECK (code IN ('after_meal', 'coffee', 'stress', 'low_fluids', 'medication', 'on_period', 'feeling_sick')));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"show_stool_form\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_stool_form\" IN (0, 1)), \"show_context\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_context\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "reminder",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder\" (\"id\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"weekday\" INTEGER NULL, \"hour\" INTEGER NULL, \"minute\" INTEGER NULL, \"tz_policy\" TEXT NOT NULL DEFAULT 'follow_device', \"notification_id\" INTEGER NOT NULL DEFAULT 7001, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (weekday IS NULL OR weekday BETWEEN 1 AND 7), CHECK (hour IS NULL OR hour BETWEEN 0 AND 23), CHECK (minute IS NULL OR minute BETWEEN 0 AND 59), CHECK (tz_policy IN ('follow_device')));"
        }
      ]
    }
